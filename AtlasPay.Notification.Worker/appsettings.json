{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "MaxRetries": 3,
    "Consumers": {
      "Finance": {
        "Topic": "finance.events",
        "GroupId": "atlaspay-notification",
        "DeadLetterTopic": "finance.events.notification.dlq"
      },
      "Identity": {
        "Topic": "identity.user.registered.v1",
        "GroupId": "atlaspay-notification-identity",
        "DeadLetterTopic": "identity.user.registered.notification.dlq"
      }
    }
  }
}
